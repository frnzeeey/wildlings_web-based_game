{
  "name": "wildlings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "dev:legacy": "vite legacy",
    "build": "npm run assets && npm run sync:godot && npm run build -w web",
    "start": "npm start -w server",
    "assets": "node tools/gen-art.mjs && node tools/gen-sfx.mjs",
    "sync:godot": "node tools/sync-godot.mjs",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "test": "npm run test:spec && vitest run",
    "test:spec": "node tools/sync-godot.mjs --check",
    "test:godot": "node tools/run-godot-tests.mjs",
    "test:e2e": "node tools/e2e-web.mjs",
    "test:cross": "node tools/cross-client.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
